{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "node",
    "outDir": "./build",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": false
  },
  "files": [
    "displayAllInCurrentMonitor.ts",
    "helper.functions.ts"
  ],
  "exclude": [
    "node_modules",
    "build"
  ]
}

