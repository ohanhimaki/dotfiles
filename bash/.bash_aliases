
# --- Easier Navigation ---
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'
alias .....='cd ../../../..'
alias ......='cd ../../../../..'
alias ~='cd ~'

# --- Navigation Shortcuts ---
alias drop='cd ~/Documents/Dropbox'
alias dt='cd ~/Desktop'
alias docs='cd ~/Documents'
alias dl='cd ~/Downloads'
alias dotf='cd ~/dotfiles'

# --- Directory Listing ---
# List in long format, colorized
alias l='ls -lF --color=auto'
# Only directories
alias lsd='ls -d */'
alias lg='lazygit'
